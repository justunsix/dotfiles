// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // Appearance
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Ayu Dark"
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  // System
  // Let package manager manage updates
  "auto_update": false,
  "proxy": "",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  // Reduce graphical requirements low GPU machines (default is false)
  // "reduce_motion": true,
  // Input
  "vim_mode": true,
  // Editing
  "format_on_save": "on",
  // Security
  "session": {
    "trust_all_worktrees": true
  },
  // AI
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "agent": {
    "default_profile": "ask",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini",
      "enable_thinking": true,
      "effort": "medium"
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
    "auto_compact": {
      "threshold": "90%"
    }
  },
  "edit_predictions": {
    "provider": "copilot"
  }
}
